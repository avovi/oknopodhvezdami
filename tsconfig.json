{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "outFile": "script.js",
    "removeComments": false,
    "sourceMap": false,
    "types": []
  },
  "include": [
    "src/main.ts"
  ]
}
