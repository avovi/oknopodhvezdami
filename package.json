{
  "name": "oknopodhvezdami",
  "version": "1.0.0",
  "description": "Web prázdninového domu Okno pod hvězdami, Městečko Trnávka",
  "private": true,
  "scripts": {
    "build": "npm run build:skript && npm run build:stranky",
    "build:skript": "tsc -p tsconfig.json",
    "build:stranky": "tsc -p tsconfig.generator.json && node .build/kresba.js && node .build/generuj.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npx -y serve -l 8123 ."
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "roughjs": "^4.6.6",
    "typescript": "^5.6.3"
  },
  "type": "module"
}
